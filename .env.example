# --- MinIO: credenciales de SOLO LECTURA (usuario tiler-ro, policy readonly) ---
# En Railway usar la red privada: minio.railway.internal:9000 con MINIO_SECURE=False
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_SECURE=False

# --- Token de mapa ---
# MISMO valor que GeoData__MapTokenSecret en Geocore. Sin esto, /cog/* da 503.
MAP_TOKEN_SECRET=

# --- CORS ---
# En producción, el dominio del front. No dejar "*".
CORS_ALLOW_ORIGINS=*
