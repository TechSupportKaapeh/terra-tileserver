# --- MinIO: credenciales de SOLO LECTURA (usuario tiler-ro) ---
# En Railway usar la red privada: minio.railway.internal:9000 con MINIO_SECURE=False
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_SECURE=False

# Bucket unico de los COG. TIENE que coincidir con GeoData__MinioBucket de
# Geocore: el arma la URL como s3://{bucket}/{storage_key}. Ademas acota que
# rutas acepta este servicio en ?url= (defensa contra SSRF).
MINIO_BUCKET=terra-assets

# GDAL la exige aunque MinIO no la use.
AWS_REGION=us-east-1

# --- Token de mapa ---
# MISMO valor que GeoData__MapTokenSecret en Geocore. Sin esto, /cog/* da 503.
MAP_TOKEN_SECRET=

# --- CORS ---
# En produccion, el dominio del front. No dejar "*".
CORS_ALLOW_ORIGINS=*

# --- Cache de tiles ---
# Los COG son inmutables, asi que un año es razonable. Bajalo si necesitas
# invalidar rapido durante pruebas.
TILE_CACHE_SECONDS=31536000
